// Cloudflare Worker: serve o site (dist/) e o backend do formulário (worker/).
// Antes do primeiro deploy, ver "Publicar na Cloudflare" em design-system.md (seção 11).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalenza-digital",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // o Worker só entra na raiz (idioma) e na API; o resto é arquivo estático direto
    "run_worker_first": ["/", "/api/*"]
  },
  // 5 envios por minuto por IP no formulário
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "4201", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true },
  "vars": {
    // domínio de produção (o token do Turnstile precisa ter sido gerado nele) e endereços do e-mail
    "TURNSTILE_HOSTNAME": "",
    "CONTACT_TO": "",
    "CONTACT_FROM": ""
  }
  // Envio pelo Email Routing da Cloudflare (domínio no Cloudflare + destino verificado):
  // "send_email": [{ "name": "MAIL", "destination_address": "seu-email@dominio.com" }]
  // Segredos (nunca neste arquivo): wrangler secret put TURNSTILE_SECRET  (e, se usar Resend, RESEND_API_KEY)
}
