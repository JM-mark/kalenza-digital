---
// Peça visual do hero: octógonos concêntricos em linha dourada que se desenham na entrada e giram
// devagar (cada anel num sentido e ritmo), com leve parallax pelo mouse (scripts/hero-art.ts).
// No celular fica só o anel externo, parado e discreto. Fica por trás do texto e na frente do vídeo.
const octo = (r: number, c = 300) =>
  'M' + Array.from({ length: 8 }, (_, k) => {
    const a = ((22.5 + 45 * k) * Math.PI) / 180;
    return `${(c + r * Math.cos(a)).toFixed(1)} ${(c + r * Math.sin(a)).toFixed(1)}`;
  }).join(' L') + ' Z';
const rings = [
  { r: 286, cls: 'ha__r1', w: 1.1 },
  { r: 222, cls: 'ha__r2', w: 1 },
  { r: 158, cls: 'ha__r3', w: 1 },
  { r: 96, cls: 'ha__r4', w: 1.2 },
];
// ponto de destaque: um pequeno octógono preenchido num vértice do anel externo
const a0 = (22.5 * Math.PI) / 180;
const dot = { x: 300 + 286 * Math.cos(a0), y: 300 + 286 * Math.sin(a0) };
// K do monograma (components/monogram.svg) no centro, parado: glifo de ~222 de altura, centrado em (122.7, -111.1)
const K_PATH = 'M89.51808 -113.32608Q108.88192 -112.37376 122.37312 -103.9616Q135.86432 -95.54944 145.70496 -83.01056Q155.5456 -70.47168 163.79904 -56.821760000000005Q172.05248 -43.17184 180.9408 -31.10912Q189.82912 -19.0464 201.25696 -11.42784Q212.6848 -3.80928 228.87424 -3.80928L229.50912 0.0H185.38496Q177.13152 0.0 168.71936 -7.77728Q160.3072 -15.55456 151.73631999999998 -27.776Q143.16544 -39.99744 133.95968 -53.64736Q124.75392 -67.29728 114.75456 -79.67743999999999Q104.7552 -92.0576 93.6448 -100.15232Q82.5344 -108.24704 69.8368 -108.56448V-71.74144Q69.8368 -48.56832 70.63040000000001 -34.9184Q71.424 -21.26848 74.43968000000001 -14.60224Q77.45536 -7.936 83.64544000000001 -5.8726400000000005Q89.83552 -3.80928 100.62848 -3.80928L101.26336 0.0H15.872L16.50688 -3.80928Q27.29984 -3.80928 33.48992 -5.8726400000000005Q39.68 -7.936 42.695679999999996 -14.60224Q45.71136 -21.26848 46.66368 -34.9184Q47.616 -48.56832 47.616 -71.74144V-150.46656Q47.616 -173.63968 46.66368 -187.2896Q45.71136 -200.93952 42.695679999999996 -207.76448Q39.68 -214.58944 33.48992 -216.6528Q27.29984 -218.71616 16.50688 -218.71616L15.872 -222.208H101.26336L100.62848 -218.71616Q89.83552 -218.71616 83.64544000000001 -216.6528Q77.45536 -214.58944 74.43968000000001 -207.76448Q71.424 -200.93952 70.63040000000001 -187.2896Q69.8368 -173.63968 69.8368 -150.46656V-114.2784Q78.09024 -115.8656 88.56576 -122.37312Q99.04128 -128.88064 109.83424 -139.03872Q120.6272 -149.1968 129.67424 -161.1008Q138.72128 -173.0048 144.27648 -185.22624Q149.83168 -197.44768 149.83168 -208.24064Q149.83168 -213.63712 146.65728000000001 -216.17664000000002Q143.48288 -218.71616 134.27712 -218.71616L133.64224 -222.208H212.36736L211.73248 -218.71616Q195.54304 -218.71616 185.06752 -214.272Q174.592 -209.82784 167.60832 -202.20928Q160.62464 -194.59072 154.43456 -184.27392Q148.24448 -173.95712 140.30848 -162.21184Q132.37248 -150.46656 120.46848 -137.92768Q108.56448 -125.3888 89.51808 -113.32608Z';
const ks = 0.5;
---
<div class="ha" data-hero-art>
  <svg viewBox="0 0 600 600" class="ha__svg">
    {rings.map((g, i) => (
      <g class="ha__layer" data-depth={i + 1}>
        <g class:list={['ha__ring', g.cls]}>
          <path d={octo(g.r)} pathLength="100" stroke-width={g.w} />
          {i === 0 && <path class="ha__dot" d={octo(9, 0)} transform={`translate(${dot.x.toFixed(1)} ${dot.y.toFixed(1)})`} />}
        </g>
      </g>
    ))}
    <g class="ha__layer" data-depth="0.5">
      <path class="ha__k" d={K_PATH} transform={`translate(${(300 - 122.7 * ks).toFixed(1)} ${(300 + 111.1 * ks).toFixed(1)}) scale(${ks})`} />
    </g>
  </svg>
</div>
