---
import logo from './logo-horizontal.svg?raw';
import Button from './Button.astro';
import { wa, SELECTOR_LANGS, type Lang, BASE } from '../lib/config';
import { t } from '../lib/i18n';

const { lang, path = '' } = Astro.props as { lang: Lang; path?: string };
const c = t(lang); const s = c.site;
const home = `${BASE}/${lang}/`;
const links = [['sobre', s.nav.sobre], ['servicos', s.nav.servicos], ['projetos', s.nav.trabalhos], ['processo', s.nav.processo], ['contato', s.nav.contato]];
const LABEL: Record<Lang, string> = { pt: 'PT', en: 'EN', ar: 'عربي' };
const langs: [Lang, string][] = SELECTOR_LANGS.map((l) => [l, LABEL[l]]);
---
<header class="hdr" data-tone="dark" id="hdr">
  <div class="hdr__bar wrap">
    <a class="hdr__logo" href={home} aria-label="Kalenza Digital"><Fragment set:html={logo} /></a>
    <nav class="hdr__nav" aria-label={s.nav.menu}>
      {links.map(([id, label]) => <a class="ulink" href={`${home}#${id}`}>{label}</a>)}
    </nav>
    <div class="hdr__end">
      <div class="hdr__langs" role="group" aria-label={s.nav.lang}>
        {langs.map(([l, label]) => (
          <a class="ulink" href={`${BASE}/${l}/${path}`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{label}</a>
        ))}
      </div>
      <Button href={wa(c.wa_text)} variant="ghost" external class="hdr__cta" magnetic>{s.nav.cta}</Button>
      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu" data-open={s.nav.menu} data-close={s.nav.close}>
        <span class="sr">{s.nav.menu}</span><i></i><i></i>
      </button>
    </div>
  </div>
</header>

<div class="menu dark" id="menu" hidden>
  <div class="menu__pat" aria-hidden="true"></div>
  <nav class="menu__nav wrap" aria-label={s.nav.menu}>
    {links.map(([id, label], i) => <a href={`${home}#${id}`} style={`--i:${i}`}>{label}</a>)}
  </nav>
  <div class="menu__foot wrap">
    <div class="hdr__langs">
      {langs.map(([l, label]) => <a class="ulink" href={`${BASE}/${l}/${path}`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{label}</a>)}
    </div>
    <Button href={wa(c.wa_text)} variant="primary" external>{s.hero.secondary}</Button>
  </div>
</div>
