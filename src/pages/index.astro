---
// Raiz: na Cloudflare o Worker redireciona pelo Accept-Language antes (worker/index.ts).
// Aqui fica o reserva em JS: escolha salva → ?lang= → idioma do navegador → PT.
import { BUILD_LANGS, BASE } from '../lib/config';
const langs = JSON.stringify(BUILD_LANGS);
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Kalenza Digital</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={Astro.site!.href.replace(/\/$/, '') + BASE + '/pt/'} />
  <meta name="theme-color" content="#10151F" />
  <script is:inline define:vars={{ langs, base: BASE }}>
    (function () {
      var ok = JSON.parse(langs), pick = null;
      try { pick = localStorage.getItem('kalenza-lang'); } catch (e) {}
      var q = new URLSearchParams(location.search).get('lang');
      if (q) pick = q.slice(0, 2).toLowerCase();
      if (ok.indexOf(pick) < 0) {
        pick = 'pt';
        var nav = navigator.languages || [navigator.language || ''];
        for (var i = 0; i < nav.length; i++) { var l = (nav[i] || '').slice(0, 2).toLowerCase(); if (ok.indexOf(l) >= 0) { pick = l; break; } }
      }
      location.replace(base + '/' + pick + '/');
    })();
  </script>
  <noscript><meta http-equiv="refresh" content={`0; url=${BASE}/pt/`} /></noscript>
  <style>html,body{margin:0;background:#10151F;height:100%}</style>
</head>
<body></body>
</html>
