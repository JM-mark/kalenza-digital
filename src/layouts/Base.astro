---
import '../styles/global.css';
import '../styles/components.css';
import '../styles/home.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaFloat from '../components/WaFloat.astro';
import Intro from '../components/Intro.astro';
import { SITE, BUILD_LANGS, HREFLANG, type Lang, BASE } from '../lib/config';
import { t, dir } from '../lib/i18n';

interface Props { lang: Lang; title: string; description: string; path?: string }
const { lang, title, description, path = '' } = Astro.props;
const c = t(lang);
const base = Astro.site!.href.replace(/\/$/, '') + BASE;
const url = (l: Lang) => `${base}/${l}/${path}`;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: `${base}/`,
  logo: `${base}/img/kalenza-monograma_fundo-claro.svg`,
  description,
  knowsLanguage: ['pt-BR', 'en', 'ar'],
  contactPoint: [{ '@type': 'ContactPoint', contactType: 'sales', telephone: '+' + SITE.whatsapp, availableLanguage: ['Portuguese', 'English', 'Arabic'] }],
  ...(SITE.email ? { email: SITE.email } : {}),
  ...(SITE.instagram ? { sameAs: [`https://instagram.com/${SITE.instagram}`] } : {}),
};
const fonts = lang === 'ar' ? ['reem-kufi', 'plex-arabic-regular'] : ['prata', 'nsd-italic-400', 'albert-sans'];
---
<!doctype html>
<html lang={HREFLANG[lang]} dir={dir(lang)}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url(lang)} />
  {BUILD_LANGS.map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={url(l)} />)}
  <link rel="alternate" hreflang="x-default" href={url('pt')} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kalenza Digital" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url(lang)} />
  <meta property="og:locale" content={HREFLANG[lang].replace('-', '_')} />
  <meta name="theme-color" content="#10151F" />
  <link rel="icon" href={`${BASE}/favicon.svg`} type="image/svg+xml" />
  {fonts.map((f) => <link rel="preload" href={`${BASE}/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />)}
  <script is:inline>
    // js ativo + abertura só na primeira visita da sessão (nunca com movimento reduzido)
    // ?motion=on força os efeitos mesmo com "reduzir movimento" ligado no aparelho (salvo neste aparelho); ?motion=off volta ao padrão
    (function () {
      var d = document.documentElement; d.classList.add('js');
      try {
        var m = new URLSearchParams(location.search).get('motion');
        if (m === 'on') localStorage.setItem('kz-motion', 'on');
        if (m === 'off') localStorage.removeItem('kz-motion');
        if (localStorage.getItem('kz-motion') === 'on') d.classList.add('motion-on');
      } catch (e) {}
      try {
        var calm = matchMedia('(prefers-reduced-motion: reduce)').matches && !d.classList.contains('motion-on');
        if (!calm && !sessionStorage.getItem('kz-intro')) {
          d.classList.add('intro'); sessionStorage.setItem('kz-intro', '1');
        }
      } catch (e) {}
    })();
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
</head>
<body id="top">
  <Intro />
  <a class="skip" href="#main">{c.site.skip}</a>
  <Header lang={lang} path={path} />
  <main id="main"><slot /></main>
  <Footer lang={lang} />
  <WaFloat label={c.site.wa_float} text={c.wa_text} />
  <script>
    import '../scripts/main';
  </script>
</body>
</html>
